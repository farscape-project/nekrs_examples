[GENERAL]
polynomialOrder = 3

stopAt = endTime
endTime = 40
dt = targetCFL=1.5 + max=0.1 + initial=0.0025  # adaptive timestep
timeStepper = tombo2

writeControl = simulationTime
writeInterval = 5

regularization = hpfrt + nModes=1 + scalingCoeff=10

[MESH]
solver = none

connectivityTol = 0.02

[PRESSURE]
residualTol = 1e-04

[VELOCITY]
boundaryTypeMap = inlet, outlet, wall
viscosity = -1.4e4  # -Re (interpreted as 1/Re)
density = 1.0
residualTol = 1e-06

[CASEDATA]
r_pipe = 0.5                    # pipe radius
u_inflow = 1.0                  # inlet mean velocity
recyc_plane_frac_offset = 0.25  # fraction of pipe length from inlet to recycling plane
